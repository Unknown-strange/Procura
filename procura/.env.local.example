NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server / Edge only — never NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GROQ_API_KEY=your-groq-key
# GEMINI_API_KEY=your-gemini-key

# App URL used in email links (no trailing slash)
APP_URL=http://localhost:3000

# --- SMTP (Gmail: use an App Password, not your normal password) ---
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Procura <your-email@gmail.com>
# Optional: default recipient for POST /api/test-email
EMAIL_TEST_TO=your-email@gmail.com
# Only needed if you call the test route in production
# ALLOW_SMTP_TEST=true
